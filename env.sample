# =============================================================================
# LLM Configuration
# The provider is determined by LLM_BASE_URL — set it to whichever endpoint
# you want to use. Uncomment one block below and fill in your credentials.
# =============================================================================

# --- Ollama (local, no API key required) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2

# --- OpenAI ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o

# --- OpenRouter (free models + Anthropic Claude, Google Gemini, Meta Llama, Mistral) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-...
# LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free
# LLM_MODEL=anthropic/claude-3.5-sonnet
# LLM_MODEL=google/gemini-flash-1.5
# Browse free models: https://openrouter.ai/models?supported_parameters=free

# --- Groq (fast open-source inference) ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.1-8b-instant

# --- Together AI ---
# LLM_BASE_URL=https://api.together.xyz/v1
# LLM_API_KEY=...
# LLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo

# --- Mistral ---
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_API_KEY=...
# LLM_MODEL=mistral-small-latest

# --- Azure OpenAI ---
# LLM_BASE_URL=https://<your-resource>.openai.azure.com/openai/deployments/<deployment>/
# LLM_API_KEY=...
# LLM_MODEL=gpt-4o

# --- Amazon Bedrock ---
# Prerequisites: pip install boto3 botocore
# AWS credentials are read from standard AWS env vars (set them below), an
# AWS_PROFILE, or an IAM instance/task role — do NOT put secret keys in LLM_API_KEY.
# LLM_PROVIDER=bedrock
# LLM_MODEL=us.amazon.nova-pro-v1:0
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...          # only needed for temporary / STS credentials

# =============================================================================
# MCP server
# =============================================================================

MCP_PORT=8005
ALLOWED_TOOLS=ping,add_numbers,read_dataset,most_common_payment_method,most_popular_shopping_mall,purchases_by_gender,plot_payment_pie,get_benign_info,plot_age_distribution,average_spending_by_category

# =============================================================================
# Testbed (redteam_mcp_testbed.py)
# =============================================================================

OLLAMA_PORT=11434    # used as fallback if LLM_BASE_URL is unset
TESTBED_HOST=127.0.0.1
TESTBED_PORT=8100
GUARDRAIL=false
