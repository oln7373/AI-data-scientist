# MCP server port
MCP_PORT=8005

# LLM provider: "ollama" (default) or "openai"
LLM_PROVIDER=openai

# Optional: override the API base URL (e.g. for OpenRouter, Groq, etc.)
# Leave blank to use the provider default (api.openai.com for openai, localhost for ollama)
LLM_BASE_URL=https://openrouter.ai/api/v1

# --- Ollama settings (used when LLM_PROVIDER=ollama) ---
# Backend model
OLLAMA_MODEL="gpt-oss:20b"

# Ollama port
OLLAMA_PORT=11434

# --- OpenAI-compatible settings (used when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=meta-llama/llama-3.1-8b-instruct:free
FAITHFUL_EXTRACTION=true # Ensure llm does not modify authentic agentic system response

# Allowed tools
ALLOWED_TOOLS=add_numbers,ping,send_email,compose_email
