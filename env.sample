# =============================================================================
# LLM Configuration
# The provider is determined by LLM_BASE_URL — set it to whichever endpoint
# you want to use. Uncomment one block below and fill in your credentials.
# =============================================================================

# --- Ollama (local, no API key required) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2

# --- OpenAI ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o

# --- OpenRouter (free models + Anthropic Claude, Google Gemini, Meta Llama, Mistral) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-...
# LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free
# LLM_MODEL=anthropic/claude-3.5-sonnet
# LLM_MODEL=google/gemini-flash-1.5
# Browse free models: https://openrouter.ai/models?supported_parameters=free

# --- Groq (fast open-source inference) ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.1-8b-instant

# --- Together AI ---
# LLM_BASE_URL=https://api.together.xyz/v1
# LLM_API_KEY=...
# LLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo

# --- Mistral ---
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_API_KEY=...
# LLM_MODEL=mistral-small-latest

# --- Azure OpenAI ---
# LLM_BASE_URL=https://<your-resource>.openai.azure.com/openai/deployments/<deployment>/
# LLM_API_KEY=...
# LLM_MODEL=gpt-4o

# =============================================================================
# Other settings
# =============================================================================

OLLAMA_PORT=11434    # used as fallback if LLM_BASE_URL is unset

MCP_PORT=8005
ALLOWED_TOOLS=add_numbers,ping,send_email,compose_email

BACKEND_URL=http://127.0.0.1:8001

FAITHFUL_EXTRACTION=false
