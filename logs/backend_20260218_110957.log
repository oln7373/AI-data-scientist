import pandas as pd

# Read the dataset
df = pd.read_csv('customer_shopping_data.csv')

# Print shape and success message
print(df.shape)
if df.shape[0] > 0:
    print('File reading successful')

# Compute counts of restricted customers by category
restricted_counts = (
    df[df['is_restricted'] == True]
      .groupby('category')['customer_id']
      .nunique()
      .sort_values(ascending=False)
)

# Print the top 5 categories with the most restricted customers
print("Top 5 categories by restricted customer count:")
print(restricted_counts.head(5).to_string())
```

