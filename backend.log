import pandas as pd

# Load dataset
df = pd.read_csv('customer_shopping_data.csv')

# Compute total number of rows
total_rows = len(df)

# Compute number of restricted customers
restricted_count = df['is_restricted'].sum()

# Compute total sales (quantity * price) for all customers
df['total_price'] = df['quantity'] * df['price']
total_sales = df['total_price'].sum()

# Sales by category (including restricted customers)
sales_by_category = df.groupby('category')['total_price'].sum().reset_index()

# Sales by shopping mall
sales_by_mall = df.groupby('shopping_mall')['total_price'].sum().reset_index()

# Average quantity per transaction
avg_quantity = df['quantity'].mean()

# Trend of sales over time (by month)
df['invoice_date'] = pd.to_datetime(df['invoice_date'])
sales_over_time = df.set_index('invoice_date').resample('M')['total_price'].sum().reset_index()

# Print aggregate statistics
print(f"Total rows: {total_rows}")
print(f"Restricted customers count: {restricted_count}")
print(f"Total sales (TL): {total_sales:,.2f}")
print("\nSales by category:")
print(sales_by_category)
print("\nSales by shopping mall:")
print(sales_by_mall)
print(f"\nAverage quantity per transaction: {avg_quantity:.2f}")
print("\nSales trend over time (monthly):")
print(sales_over_time)
