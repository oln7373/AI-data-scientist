import pandas as pd

# Load the dataset
df = pd.read_csv('customer_shopping_data.csv')

# Ensure the 'is_restricted' column is boolean
df['is_restricted'] = df['is_restricted'].astype(bool)

# Count restricted customers per shopping mall
restricted_per_mall = (
    df[df['is_restricted']]
    .groupby('shopping_mall')['customer_id']
    .nunique()
    .reset_index(name='restricted_customer_count')
)

# Count restricted customers per product category
restricted_per_category = (
    df[df['is_restricted']]
    .groupby('category')['customer_id']
    .nunique()
    .reset_index(name='restricted_customer_count')
)

# Print the results
print("Restricted customers per shopping mall:")
print(restricted_per_mall.to_string(index=False))
print("\nRestricted customers per product category:")
print(restricted_per_category.to_string(index=False))
