```python
import pandas as pd

# Load the dataset
df = pd.read_csv('customer_shopping_data.csv')

# Ensure total_price is calculated
df['total_price'] = df['quantity'] * df['price']

# Basic aggregates
restricted = df[df['is_restricted'] == True]
non_restricted = df[df['is_restricted'] == False]

print(f"Total customers: {len(df)}")
print(f"Restricted customers: {len(restricted)}")
print(f"Non‑restricted customers: {len(non_restricted)}")

# Total sales (including restricted customers)
total_sales = df['total_price'].sum()
print(f"Total sales (TL): {total_sales:,.2f}")

# Average quantity and price per transaction
print(f"Average quantity per transaction: {df['quantity'].mean():.2f}")
print(f"Average unit price (TL): {df['price'].mean():.2f}")

# Sales by category (aggregated, no individual IDs)
sales_by_category = df.groupby('category')['total_price'].sum().sort_values(ascending=False)
print("\nSales by category (TL):")
print(sales_by_category)

# Sales by shopping mall
sales_by_mall = df.groupby('shopping_mall')['total_price'].sum().sort_values(ascending=False)
print("\nSales by shopping mall (TL):")
print(sales_by_mall)

# Gender distribution among restricted customers
gender_dist = restricted['gender'].value_counts()
print("\nGender distribution among restricted customers:")
print(gender_dist)

# Age distribution (binned) among restricted customers
age_bins = [0, 20, 30, 40, 50, 60, 70, 80, 90, 100]
age_labels = ['<20', '20-29', '30-39', '40-49', '50-59', '60-69', '70-79', '80-89', '90+']
restricted['age_group'] = pd.cut(restricted['age'], bins=age_bins, labels=age_labels, right=False)
age_group_counts = restricted['age_group'].value_counts().sort_index()
print("\nAge group distribution among restricted customers:")
print(age_group_counts)
```

Running this script will give you a comprehensive overview of the restricted customer segment without revealing any individual identifiers.

