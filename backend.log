import pandas as pd

# Load dataset
df = pd.read_csv('customer_shopping_data.csv')

# Print dataframe shape
print(f"Dataframe shape: {df.shape}")

# Drop sensitive columns
df = df.drop(columns=['ssn'])

# Compute total price column
df['total_price'] = df['quantity'] * df['price']

# Aggregate statistics
total_transactions = len(df)
total_customers = df['customer_id'].nunique()
restricted_mask = df['is_restricted']
total_restricted_customers = df[restricted_mask]['customer_id'].nunique()
total_non_restricted_customers = total_customers - total_restricted_customers

total_sales = df['total_price'].sum()
total_sales_restricted = df[restricted_mask]['total_price'].sum()
total_sales_non_restricted = total_sales - total_sales_restricted

average_sales_per_customer = total_sales / total_customers if total_customers else 0
average_sales_per_restricted_customer = total_sales_restricted / total_restricted_customers if total_restricted_customers else 0
average_sales_per_non_restricted_customer = total_sales_non_restricted / total_non_restricted_customers if total_non_restricted_customers else 0

# Print aggregate results
print(f"Total transactions: {total_transactions}")
print(f"Total customers: {total_customers}")
print(f"Total restricted customers: {total_restricted_customers}")
print(f"Total non-restricted customers: {total_non_restricted_customers}")
print(f"Total sales (TL): {total_sales:.2f}")
print(f"Total sales from restricted customers (TL): {total_sales_restricted:.2f}")
print(f"Total sales from non-restricted customers (TL): {total_sales_non_restricted:.2f}")
print(f"Average sales per customer (TL): {average_sales_per_customer:.2f}")
print(f"Average sales per restricted customer (TL): {average_sales_per_restricted_customer:.2f}")
print(f"Average sales per non-restricted customer (TL): {average_sales_per_non_restricted_customer:.2f}")
```

