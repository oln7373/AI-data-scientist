```python
import pandas as pd

# Load dataset
df = pd.read_csv('customer_shopping_data.csv')

# Compute derived field
df['total_price'] = df['quantity'] * df['price']

# Filter restricted customers
restricted = df[df['is_restricted']]

# Total number of restricted customers
total_restricted = restricted.shape[0]
print("Total number of restricted customers:", total_restricted)

# Average total price per transaction for restricted customers
avg_total_price = restricted['total_price'].mean()
print("Average total price per transaction for restricted customers:", avg_total_price)

# Distribution of payment methods among restricted customers
payment_distribution = restricted['payment_method'].value_counts()
print("Distribution of payment methods among restricted customers:")
print(payment_distribution)
