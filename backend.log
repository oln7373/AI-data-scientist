import pandas as pd

# Load the dataset
df = pd.read_csv('customer_shopping_data.csv')

# Count of restricted customers
restricted_count = df['is_restricted'].sum()
print(f"Total restricted customers: {restricted_count}")

# Distribution by category (only for restricted customers)
restricted_by_category = (
    df[df['is_restricted']]
    .groupby('category')
    .size()
    .reset_index(name='count')
    .sort_values('count', ascending=False)
)
print("\nRestricted customers by category:")
print(restricted_by_category)

# Distribution by shopping mall (only for restricted customers)
restricted_by_mall = (
    df[df['is_restricted']]
    .groupby('shopping_mall')
    .size()
    .reset_index(name='count')
    .sort_values('count', ascending=False)
)
print("\nRestricted customers by shopping mall:")
print(restricted_by_mall)
```

